{
  "name": "butterdawg",
  "version": "1.0.0",
  "description": "FL Studio clone with Electron (WIP)",
  "main": "main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc -p . --noEmit",
    "start": "npm run build && electron .",
    "start:forge": "electron-forge start",
    "shot": "bash scripts/shot.sh",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "smoke": "xvfb-run -a node scripts/smoke.cjs",
    "test:engine": "xvfb-run -a node scripts/engine-test.cjs",
    "test:project": "xvfb-run -a node scripts/project-test.cjs",
    "test:beat": "xvfb-run -a node scripts/beat-test.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jaybee18/butterDAWg.git"
  },
  "author": "Jan Bessler",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Jaybee18/butterDAWg/issues"
  },
  "homepage": "https://github.com/Jaybee18/butterDAWg#readme",
  "dependencies": {
    "electron-squirrel-startup": "^1.0.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.4.0",
    "@electron-forge/maker-deb": "^7.4.0",
    "@electron-forge/maker-rpm": "^7.4.0",
    "@electron-forge/maker-squirrel": "^7.4.0",
    "@electron-forge/maker-zip": "^7.4.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.4.0",
    "@electron-forge/plugin-fuses": "^7.4.0",
    "@electron/fuses": "^1.8.0",
    "@types/audioworklet": "^0.0.35",
    "@types/react": "^18.0.26",
    "@types/uuid": "^10.0.0",
    "electron": "^45.4.1",
    "electron-reloader": "^1.2.3",
    "esbuild": "^0.28.2",
    "typescript": "~5.9",
    "wavefile": "^11.0.0"
  }
}
