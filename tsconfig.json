{
    "compilerOptions": {
      "jsx": "react",
      "allowJs": false,
      "target": "ES2022",
      "lib": ["DOM", "ES2022"],
      "types": ["audioworklet", "react"],
      "paths": { "fs": ["./src/platform/fs.ts"] },
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "noEmit": true,
      "preserveConstEnums": true,
      "strictNullChecks": false,
      "strict": true,
      "skipLibCheck": true
    },
    "exclude": ["node_modules", "dist", "built", "scripts", "vendor", "AudioNodes", "./src/free-queue.ts", "./src/test.ts", "./src/AudioGraph.ts"]
}
